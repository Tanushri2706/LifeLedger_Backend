# ==============================================================================
# LifeLedger Backend — Environment Configuration Reference (.env.example)
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=development

# Client / CORS Configuration
# In production, set to exact HTTPS frontend domain (e.g., https://app.lifeledger.health)
CLIENT_URL=http://localhost:3000

# Cookie Configuration for Refresh Tokens
# COOKIE_SAME_SITE: 'lax' (default), 'strict' (same-site only), 'none' (cross-subdomain/cross-site HTTPS)
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN: Optional parent domain for sibling subdomains (e.g. .lifeledger.health). Leave empty for single host/localhost.
# COOKIE_DOMAIN=.lifeledger.health

# Database Configuration (REQUIRED in all environments)
# Production: MongoDB Atlas connection string (mongodb+srv://...)
# Development: Local MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/lifeledger

# DNS Resolver Configuration (Optional: fixes Windows Node.js querySrv ECONNREFUSED)
# Comma-separated list of DNS servers for Node's c-ares resolver before Atlas SRV lookups.
# Default fallback: 1.1.1.1,8.8.8.8
DNS_SERVERS=1.1.1.1,8.8.8.8

# JWT & Authentication Security (REQUIRED in production, minimum 32 random characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRY_MINUTES=10

# Cloudinary Medical Storage (REQUIRED in production; optional mock fallback in development)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google Gemini AI Health Intelligence (REQUIRED in production; optional mock fallback in development)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Healthcare Location & Maps Discovery (Free OpenStreetMap or Google Maps)
# MAPS_PROVIDER: 'osm' (production default; free, open, no paid API key), 'google' (requires GOOGLE_MAPS_API_KEY), or 'mock' (dev only)
MAPS_PROVIDER=osm
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Optional Google Maps fallback/provider key (only required when MAPS_PROVIDER=google)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Brevo Transactional Auth Email / OTP (REQUIRED in production; optional mock fallback in development)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=notifications@lifeledger.health
BREVO_SENDER_NAME=LifeLedger

